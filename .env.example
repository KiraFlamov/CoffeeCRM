# Для docker compose: скопируйте в .env (рядом с docker-compose.yml) и подставьте свои значения

POSTGRES_PASSWORD=замените_на_пароль_базы
JWT_SECRET=замените_на_длинную_случайную_строку

# Аккаунты, которые создаются при первом запуске
SEED_ADMIN_EMAIL=admin@test.com
SEED_ADMIN_PASSWORD=замените
SEED_CASHIER_EMAIL=cashier@test.com
SEED_CASHIER_PASSWORD=замените

# Порты на хосте: фронтенд http://localhost:8080, API http://localhost:3000/api
WEB_PORT=8080
API_PORT=3000
