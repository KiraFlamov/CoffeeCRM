# Скопируйте в CoffeeBackend/.env и подставьте свои значения

DATABASE_URL=postgresql://user:password@localhost:5432/coffeedb
JWT_SECRET=замените_на_длинную_случайную_строку
JWT_EXPIRES_IN=1d
PORT=3000
# Адрес фронтенда для CORS (несколько — через запятую)
CLIENT_ORIGIN=http://localhost:5173

# Необязательно: аккаунты для npm run seed (по умолчанию — из passwords.txt)
# SEED_ADMIN_EMAIL=admin@test.com
# SEED_ADMIN_PASSWORD=test
# SEED_CASHIER_EMAIL=cashier@test.com
# SEED_CASHIER_PASSWORD=test
